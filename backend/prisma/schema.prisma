generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("AssignedTasks")
  auditLogs     AuditLog[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  members ProjectMember[]
  tasks   Task[]
  sprints Sprint[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  userId    String
  projectId String
  role      ProjectRole

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

enum ProjectRole {
  ADMIN
  PM
  DEVELOPER
  QA
  VIEWER
}

model Sprint {
  id        String       @id @default(uuid())
  projectId String
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  sprintId    String?
  assigneeId  String?
  title       String
  description String?
  type        TaskType   @default(STORY)
  status      TaskStatus @default(OPEN)
  priority    Priority   @default(MEDIUM)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project    @relation(fields: [projectId], references: [id])
  sprint    Sprint?    @relation(fields: [sprintId], references: [id])
  assignee  User?      @relation("AssignedTasks", fields: [assigneeId], references: [id])
  auditLogs AuditLog[]
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  CODE_REVIEW
  QA
  DONE
  BLOCKED
}

enum TaskType {
  STORY
  BUG
  TASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AuditLog {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  action    String
  fromValue String?
  toValue   String?
  metadata  Json?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])
}
